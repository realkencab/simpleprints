import { getServerSession } from "next-auth";
import { redirect } from "next/navigation";
import { authOptions } from "@/app/api/auth/[...nextauth]/route"; // Import auth options
import LogoutButton from "./logout"; // Separate logout button code

export default async function DashboardPage() {
  const session = await getServerSession(authOptions);

  if (!session) {
    redirect('/login');
  }

  return (
    <div className="min-h-screen bg-brand-surface flex flex-col items-center justify-center relative">
      
      {/* Top Right Sign Out Button Container */}
      <div className="absolute top-4 right-4">
        <LogoutButton />
      </div>

      <div className="p-8 bg-white rounded-lg shadow-sm w-96 border border-brand-border text-center">
        <h1 className="text-2xl font-bold text-green-600 mb-4">
          Login Successful! 🎉
        </h1>
        <p className="text-gray-600 mb-2">
          Welcome, <strong>{session.user.name}</strong>!
        </p>
        <p className="text-sm text-gray-500 mb-6">
          Your role: <span className="font-semibold text-brand-primary">{session.user.role || 'Undefined'}</span>
        </p>
      </div>
    </div>
  );
}